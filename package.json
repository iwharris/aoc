{
    "name": "@iwharris/aoc",
    "version": "0.0.0",
    "description": "Advent of Code solutions",
    "main": "dist/src/index.js",
    "types": "./dist/src/index.d.ts",
    "bin": {
        "aoc": "./dist/src/index.js"
    },
    "scripts": {
        "aoc": "node dist/src/index.js",
        "dev": "ts-node --logError src/index.ts",
        "build": "npm run -s lint && npm run -s compile",
        "compile": "tsc",
        "compile:watch": "tsc -w",
        "eslint": "eslint .",
        "eslint:fix": "npm run eslint -- --fix .",
        "lint": "npm run -s prettier && npm run -s eslint",
        "lint:fix": "npm run -s prettier:fix && npm run -s eslint:fix",
        "prettier": "prettier --check {src,test}/**/*.[jt]s",
        "prettier:fix": "prettier --write {src,test}/**/*.[jt]s",
        "solve": "ts-node --logError src/index.ts solve",
        "test": "jest",
        "test:coverage": "jest --coverage"
    },
    "husky": {
        "hooks": {
            "pre-commit": "npm run -s lint"
        }
    },
    "repository": {
        "type": "git",
        "url": "git://github.com/iwharris/aoc.git"
    },
    "keywords": [
        "adventofcode",
        "advent",
        "typescript"
    ],
    "author": "Ian Harris",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/iwharris/aoc/issues"
    },
    "homepage": "https://github.com/iwharris/aoc#readme",
    "devDependencies": {
        "@commander-js/extra-typings": "^9.4.1",
        "@iwharris/prettier-config": "^0.0.4",
        "@types/glob": "^8.1.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^26.6.11",
        "@typescript-eslint/eslint-plugin": "^8.74.0",
        "@typescript-eslint/parser": "^8.74.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^4.2.1",
        "husky": "^4.3.0",
        "jest": "^29.7.0",
        "prettier": "^2.8.0",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "~6.0.3",
        "yarn": "^1.22.22"
    },
    "dependencies": {
        "commander": "^9.4.1",
        "glob": "^8.0.3"
    }
}
